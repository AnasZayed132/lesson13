print("diamond number pattern")
row=int(input("how many rows do you want for the diamond ."))
if row%2==0:
    halfDiamondSize=int(row/2)
else:
    halfDiamondSize=int(row/2)+1
space=halfDiamondSize-1
for i in range(1,halfDiamondSize+1):
    for j in range(1,space+1):
        print(end=" ")
    space=space-1
    num=1
    for j in range(2*i-1):
        print(end=str(num))
        num=num+1
    print()
